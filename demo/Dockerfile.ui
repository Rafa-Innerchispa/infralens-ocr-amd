FROM python:3.12-slim

WORKDIR /demo

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

ENV INFRALENS_OCR_URL=http://127.0.0.1:18765/ocr \
    INFRALENS_UI_PORT=18501

EXPOSE 18501

CMD ["sh", "-c", "streamlit run app.py --server.address=0.0.0.0 --server.port=${INFRALENS_UI_PORT} --server.headless=true --browser.gatherUsageStats=false"]
